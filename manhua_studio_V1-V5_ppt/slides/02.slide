        <Box style={{ width: 44, height: 44, background: '#1E4FA8', borderRadius: 8, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ color: '#FFFFFF', fontSize: 19, fontWeight: 'bold' }}>01</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>总览：两条轴与 V1–V5 路线</Text>
          <Text style={{ fontSize: 16, color: '#8B97A8' }}>版本迭代轴 + 三种走法轴，五版递进关系</Text>
        </Box>
      </Box>
      <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
        <Box style={{ width: 44, height: 44, background: '#1E4FA8', borderRadius: 8, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ color: '#FFFFFF', fontSize: 19, fontWeight: 'bold' }}>02</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>V1–V5 逐版功能与学生任务</Text>
          <Text style={{ fontSize: 16, color: '#8B97A8' }}>每版功能目标、学生交付物、新增构件、教师备课</Text>
        </Box>
      </Box>
      <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
        <Box style={{ width: 44, height: 44, background: '#1E4FA8', borderRadius: 8, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ color: '#FFFFFF', fontSize: 19, fontWeight: 'bold' }}>03</Text>
        </Box>
        <Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>三种走法：跟跑 / 并跑 / 领跑</Text>
          <Text style={{ fontSize: 16, color: '#8B97A8' }}>同版本内不同厚度支撑，对应弱/中/强学生</Text>
        </Box>
      </Box>
      <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
        <Box style={{ width: 44, height: 44, background: '#1E4FA8', borderRadius: 8, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
