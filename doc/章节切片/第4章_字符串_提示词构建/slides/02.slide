<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: 0 }}>
  <Box style={{ height: 56, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', paddingLeft: 40, paddingRight: 40, justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>目录 · Agenda</Text>
    <Text style={{ fontSize: 13, color: '#C7D6EE' }}>manhua.py 章节切片教学包</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', padding: '40px 56px', gap: 56 }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 26, justifyContent: 'center' }}>
      {[{ n: '01', t: '为什么切片', d: 'V1 认知过载 → 按章节拆成微案例' }, { n: '02', t: '学习目标', d: '知识 / 能力 / 素养 三维' }, { n: '03', t: '核心概念', d: '用 f-string 拼装提示词' }].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 18 }}>
          <Box style={{ width: 46, height: 46, background: '#0E3F8C', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>{it.n}</Text>
          </Box>
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>{it.t}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>{it.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 26, justifyContent: 'center' }}>
      {[{ n: '04', t: '母体函数', d: 'build_scene_prompt 与源码同名' }, { n: '05', t: '学生练习', d: '三道递进任务（必做 + 选做）' }, { n: '06', t: '验收与衔接', d: '三档标准 + 第7章衔接' }].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 18 }}>
          <Box style={{ width: 46, height: 46, background: '#1E4FA8', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>{it.n}</Text>
          </Box>
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>{it.t}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>{it.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 34, flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-end', paddingRight: 40 }}>
    <Text style={{ fontSize: 14, color: '#1E4FA8' }}>02 / 09</Text>
